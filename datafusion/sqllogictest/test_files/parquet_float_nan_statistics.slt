# NaN rows of a float column must survive Parquet statistics.
#
# Parquet writers leave NaN out of float min/max statistics, while NaN sorts above every
# number. A file holding 1.0 and NaN therefore has min = max = 1.0; trusting that maximum
# prunes the file for `column1 > 2`, answers MAX with 1.0, and reads the column as the
# constant 1.0.

query I
COPY (VALUES (1.0), ('NaN'::double), (1.0))
TO 'test_files/scratch/parquet_float_nan_statistics/t/0.parquet'
STORED AS PARQUET;
----
3

statement ok
CREATE EXTERNAL TABLE t
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_float_nan_statistics/t';

query I
SELECT count(*) FROM t WHERE column1 > 2;
----
1

query R
SELECT max(column1) FROM t;
----
NaN

query R
SELECT column1 FROM t ORDER BY column1;
----
1
1
NaN

query R
SELECT column1 FROM t ORDER BY column1 DESC LIMIT 1;
----
NaN

# The minimum is still a bound: the 'NaN' literal is never below it.
query I
SELECT count(*) FROM t WHERE column1 < 1;
----
0

statement ok
DROP TABLE t;

# Parquet writers record a zero minimum as -0.0, so MIN must not be answered from it.
query I
COPY (VALUES (0.0), (1.0))
TO 'test_files/scratch/parquet_float_nan_statistics/zero/0.parquet'
STORED AS PARQUET;
----
2

statement ok
CREATE EXTERNAL TABLE zero
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_float_nan_statistics/zero';

query T
SELECT CAST(min(column1) AS VARCHAR) FROM zero;
----
0.0

statement ok
DROP TABLE zero;
